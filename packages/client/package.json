{
  "name": "@tetsujs/client",
  "version": "0.7.0",
  "description": "A typed fetch client for Tetsu applications",
  "keywords": [
    "bun",
    "tetsu",
    "client",
    "fetch",
    "typed"
  ],
  "author": "tetsuodev",
  "license": "MIT",
  "homepage": "https://tetsujs.com/docs/packages/client/",
  "bugs": {
    "url": "https://github.com/tetsujs/tetsu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetsujs/tetsu.git",
    "directory": "packages/client"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "prepack": "bun run --cwd ../.. build"
  },
  "bin": {
    "tetsu-client": "./dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./tanstack": {
      "types": "./dist/src/tanstack.d.ts",
      "default": "./dist/src/tanstack.js"
    },
    "./contract": {
      "types": "./dist/src/contract.d.ts",
      "bun": "./dist/src/contract.js"
    }
  },
  "peerDependencies": {
    "@tanstack/query-core": "^5.102.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/query-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/query-core": "5.104.3",
    "@tanstack/react-query": "5.104.3",
    "@tanstack/solid-query": "5.104.3",
    "@tanstack/svelte-query": "6.3.3",
    "@tanstack/vue-query": "5.104.3",
    "@tetsujs/core": "workspace:*",
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "solid-js": "1.9.17",
    "svelte": "5.57.2",
    "typescript6": "npm:typescript@6.0.3",
    "vue": "3.5.44",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "src",
    "!**/*.test.ts",
    "!**/*.test-d.ts"
  ]
}
