{
  "name": "@tetsujs/cors",
  "version": "0.6.1",
  "description": "CORS headers and preflight responses for Tetsu",
  "keywords": [
    "bun",
    "tetsu",
    "cors",
    "http",
    "middleware"
  ],
  "author": "tetsuodev",
  "license": "MIT",
  "homepage": "https://tetsujs.com/docs/packages/cors/",
  "bugs": {
    "url": "https://github.com/tetsujs/tetsu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetsujs/tetsu.git",
    "directory": "packages/cors"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "prepack": "bun run --cwd ../.. build"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "peerDependencies": {
    "@tetsujs/core": "workspace:^"
  },
  "devDependencies": {
    "@tetsujs/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "src",
    "!**/*.test.ts",
    "!**/*.test-d.ts"
  ]
}
