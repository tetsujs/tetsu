{
  "name": "@tetsujs/sse",
  "version": "0.2.0",
  "description": "Server-sent events and streamed responses for Tetsu, from an async generator",
  "keywords": [
    "bun",
    "tetsu",
    "sse",
    "server-sent-events",
    "streaming",
    "ndjson"
  ],
  "author": "tetsuodev",
  "license": "MIT",
  "homepage": "https://github.com/tetsujs/tetsu/tree/main/packages/sse#readme",
  "bugs": {
    "url": "https://github.com/tetsujs/tetsu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetsujs/tetsu.git",
    "directory": "packages/sse"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "prepack": "bun run --cwd ../.. build"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "peerDependencies": {
    "@tetsujs/core": "workspace:^"
  },
  "devDependencies": {
    "@tetsujs/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "src",
    "!**/*.test.ts",
    "!**/*.test-d.ts"
  ]
}
