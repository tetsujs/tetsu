{
  "name": "@tetsujs/rate-limit",
  "version": "0.4.2",
  "description": "Fixed-window rate limiting for Tetsu, with a replaceable store",
  "keywords": [
    "bun",
    "tetsu",
    "rate-limit",
    "rate-limiting",
    "http"
  ],
  "author": "tetsuodev",
  "license": "MIT",
  "homepage": "https://github.com/tetsujs/tetsu/tree/main/packages/rate-limit#readme",
  "bugs": {
    "url": "https://github.com/tetsujs/tetsu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetsujs/tetsu.git",
    "directory": "packages/rate-limit"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "prepack": "bun run --cwd ../.. build"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "dependencies": {
    "@tetsujs/openapi": "workspace:^"
  },
  "peerDependencies": {
    "@tetsujs/core": "workspace:^"
  },
  "devDependencies": {
    "@tetsujs/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "src",
    "!**/*.test.ts",
    "!**/*.test-d.ts"
  ]
}
