{
  "name": "@tetsujs/core",
  "version": "0.4.1",
  "description": "An HTTP framework for Bun: controllers as plain classes, lifecycle hooks and end-to-end type inference, without decorators or dependencies",
  "keywords": [
    "bun",
    "http",
    "framework",
    "web-framework",
    "typescript",
    "server",
    "router",
    "controller",
    "standard-schema"
  ],
  "author": "tetsuodev",
  "license": "MIT",
  "homepage": "https://github.com/tetsujs/tetsu/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/tetsujs/tetsu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetsujs/tetsu.git",
    "directory": "packages/core"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "prepack": "bun run --cwd ../.. build"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./testing": {
      "types": "./dist/test-utils/index.d.ts",
      "default": "./dist/test-utils/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "src",
    "test-utils",
    "!**/*.test.ts",
    "!**/*.test-d.ts"
  ]
}
