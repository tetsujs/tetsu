{
  "name": "@tetsujs/core",
  "version": "0.6.0",
  "description": "An HTTP framework for Bun: controllers built from their dependencies, lifecycle hooks in fixed slots and end-to-end type inference, without decorators or dependencies",
  "keywords": [
    "bun",
    "http",
    "framework",
    "web-framework",
    "typescript",
    "server",
    "router",
    "controller",
    "standard-schema"
  ],
  "author": "tetsuodev",
  "license": "MIT",
  "homepage": "https://tetsujs.com/docs/packages/core/",
  "bugs": {
    "url": "https://github.com/tetsujs/tetsu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetsujs/tetsu.git",
    "directory": "packages/core"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "prepack": "bun run --cwd ../.. build"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./testing": {
      "types": "./dist/test-utils/index.d.ts",
      "default": "./dist/test-utils/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/*.js",
    "dist/*.js.map",
    "dist/src",
    "dist/test-utils/index.*",
    "dist/test-utils/server.*",
    "dist/test-utils/client.*",
    "dist/test-utils/ctx.*",
    "dist/test-utils/logs.*",
    "src",
    "test-utils/index.ts",
    "test-utils/server.ts",
    "test-utils/client.ts",
    "test-utils/ctx.ts",
    "test-utils/logs.ts",
    "!**/*.tsbuildinfo",
    "!**/*.test.ts",
    "!**/*.test-d.ts"
  ]
}
