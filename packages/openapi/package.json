{
  "name": "@tetsujs/openapi",
  "version": "0.4.1",
  "description": "An OpenAPI 3.1 document and docs page generated from Tetsu routes",
  "keywords": [
    "bun",
    "tetsu",
    "openapi",
    "swagger",
    "api-docs"
  ],
  "author": "tetsuodev",
  "license": "MIT",
  "homepage": "https://github.com/tetsujs/tetsu/tree/main/packages/openapi#readme",
  "bugs": {
    "url": "https://github.com/tetsujs/tetsu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetsujs/tetsu.git",
    "directory": "packages/openapi"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "prepack": "bun run --cwd ../.. build"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "peerDependencies": {
    "@tetsujs/core": "workspace:^"
  },
  "devDependencies": {
    "@tetsujs/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "src",
    "!**/*.test.ts",
    "!**/*.test-d.ts"
  ]
}
