{
  "name": "@tetsujs/lifecycle",
  "version": "0.4.1",
  "description": "Graceful shutdown for Tetsu: drain requests, then close what the server used",
  "keywords": [
    "bun",
    "tetsu",
    "graceful-shutdown",
    "shutdown",
    "kubernetes"
  ],
  "author": "tetsuodev",
  "license": "MIT",
  "homepage": "https://github.com/tetsujs/tetsu/tree/main/packages/lifecycle#readme",
  "bugs": {
    "url": "https://github.com/tetsujs/tetsu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetsujs/tetsu.git",
    "directory": "packages/lifecycle"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "prepack": "bun run --cwd ../.. build"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "src",
    "!**/*.test.ts",
    "!**/*.test-d.ts"
  ]
}
