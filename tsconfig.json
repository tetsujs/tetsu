{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    // Inside the repository a package resolves to its sources, so nothing
    // has to be built to run, test or type-check. A user resolves through
    // `exports` to `dist`; `tsconfig.lib.json` clears these for the build.
    "paths": {
      "@tetsujs/core/testing": ["./packages/core/test-utils/index.ts"],
      "@tetsujs/*": ["./packages/*/src/index.ts"]
    }
  },
  "exclude": ["**/node_modules", "**/dist"]
}
