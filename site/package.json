    "sharp": "0.35.5",
    "starlight-llms-txt": "0.12.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "arktype": "2.2.5",
    "openapi-fetch": "0.17.0",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "valibot": "1.5.0",
    "wrangler": "4.145.0",
    "zod": "4.6.5"
