# Every response: no MIME sniffing, no framing by other sites, the path kept
# to this origin in the referrer, and HTTPS remembered for a year.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000

# Markdown and plain text are UTF-8. Without a charset, a browser opening
# one of them may read it as Latin-1 and garble dashes and the µ sign.
/*.md
  Content-Type: text/markdown; charset=utf-8
/*.txt
  Content-Type: text/plain; charset=utf-8

# File names under /_astro/ carry a hash of their content: a change is a new
# name, so a copy never goes stale.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The name stays when the file changes: kept for a day, then checked again.
/og.png
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/logo-light.svg
  Cache-Control: public, max-age=86400
/logo-dark.svg
  Cache-Control: public, max-age=86400
