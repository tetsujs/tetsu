---
import LanguageSelect from "@astrojs/starlight/components/LanguageSelect.astro";
import Search from "@astrojs/starlight/components/Search.astro";
import SocialIcons from "@astrojs/starlight/components/SocialIcons.astro";
import ThemeSelect from "@astrojs/starlight/components/ThemeSelect.astro";
import SiteTitle from "./SiteTitle.astro";

const links = [
  { label: "Docs", href: "/docs/" },
  { label: "Blog", href: "/blog/" },
];

const path = Astro.url.pathname;

// The link to this very page is the current page; the one to the section a
// page is in only marks where the reader is.
const current = (href: string) => {
  if (path === href) return "page";

  return path.startsWith(href) ? "true" : undefined;
};
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
    {/* The sidebar's navigation is already labelled "Main". */}
    <nav class="links" aria-label="Site">
      {
        links.map((link) => (
          <a href={link.href} aria-current={current(link.href)}>
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
  <div class="sl-flex print:hidden">
    <Search />
  </div>
  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <div class="sl-flex social-icons">
      <SocialIcons />
    </div>
    <ThemeSelect />
    <LanguageSelect />
  </div>
</div>

<style>
  .header {
    translate: 0 var(--header-row-shift);
    display: flex;
    gap: var(--sl-nav-gap);
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }
  .title-wrapper {
    overflow: clip visible;
    padding: 0.25rem;
    margin: -0.25rem;
    min-width: 0;
    align-items: center;
    gap: var(--logo-menu-gap);
  }
  .links {
    display: flex;
    gap: 1.25rem;
  }
  .links a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
    font-weight: 600;
    font-size: var(--sl-text-sm);
  }
  .links a:hover,
  .links a[aria-current] {
    color: var(--sl-color-white);
  }
  .right-group,
  .social-icons {
    gap: 1rem;
    align-items: center;
  }
  .social-icons::after {
    content: "";
    height: 2rem;
    border-inline-end: 1px solid var(--sl-color-gray-5);
  }
  /*
   * The search sits over the column of the docs' text on every page, so it
   * stays put going from the docs to the home page: the header lays out
   * the columns of a docs page, a sidebar, the text and a table of
   * contents as wide as the sidebar, whatever the page lays out itself.
   */
  @media (min-width: 50rem) {
    .header {
      --__sidebar-width: max(0rem, var(--sl-sidebar-width) - var(--sl-nav-pad-x));
      --__main-column-fr: calc((100% - 2 * var(--sl-sidebar-width) - var(--tetsu-docs-width)) / 2);
      display: grid;
      grid-template-columns:
        minmax(calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))), auto)
        1fr
        auto;
      align-content: center;
    }
  }
</style>
