---
const principles = [
  {
    title: "Controllers without decorators",
    text: "A named function from its dependencies to its routes, called once where the application is wired.",
  },
  {
    title: "Flat, and no magic",
    text: "No registry, no file scanning, no reflection, no container. Any point of the application reads top to bottom.",
  },
  {
    title: "Types do not lie",
    text: "A field is on ctx exactly when it exists: the body after validation, the user after the hook that found them.",
  },
  {
    title: "Explicit over DRY",
    text: "A route lists its hooks by slot, in the order they run. Similar routes repeat them instead of inheriting them.",
  },
  {
    title: "The platform, not a wrapper",
    text: "Bun's router, Headers, CookieMap, the real server. No dependencies in the core.",
  },
];
---

<section class="section">
  <p class="kicker">Principles</p>
  <h2>Iron, not magic.</h2>
  <ol class="grid">
    {
      principles.map((principle) => (
        <li>
          <h3>{principle.title}</h3>
          <p>{principle.text}</p>
        </li>
      ))
    }
    <li class="more">
      <a href="/about/">Why it is built this way →</a>
    </li>
  </ol>
</section>

<style>
  .grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1px;
    background: var(--sl-color-gray-5);
    border: 1px solid var(--sl-color-gray-5);
    counter-reset: principle;
  }
  @media (min-width: 50rem) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  li {
    background: var(--sl-color-black);
    padding: 1.5rem;
    counter-increment: principle;
  }
  li:not(.more)::before {
    content: "0" counter(principle);
    font-family: var(--__sl-font-mono, ui-monospace, monospace);
    color: #ff4d57;
    font-size: var(--sl-text-sm);
  }
  /* The brand red is too dark for small text on the dark background (3.1:1),
     so the dark theme uses a lighter red (5.4:1). */
  :global([data-theme="light"]) li:not(.more)::before {
    color: var(--tetsu-red);
  }
  h3 {
    color: var(--sl-color-white);
    font-size: 1.05rem;
    margin: 0.5rem 0;
  }
  p {
    color: var(--sl-color-gray-2);
    margin: 0;
    font-size: var(--sl-text-sm);
    line-height: 1.6;
  }
  .more {
    display: grid;
    place-items: center;
  }
  .more a {
    color: var(--sl-color-white);
    font-weight: 600;
    text-decoration: none;
  }
</style>
