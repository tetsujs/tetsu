---
import { Code } from "@astrojs/starlight/components";
import { caught } from "./samples";
---

<section class="section">
  <p class="kicker">Caught before it runs</p>
  <h2>The compiler knows what the framework knows.</h2>
  <div class="caught">
    {
      caught.map((_, index) => (
        <input class="choice" type="radio" name="caught" id={`caught-${index}`} checked={index === 0} />
      ))
    }
    <div class="list">
      {
        caught.map((item, index) => (
          <label for={`caught-${index}`}>
            <span class="cross" aria-hidden="true">
              ✕
            </span>
            {item.label}
          </label>
        ))
      }
    </div>
    <div class="panels">
      {
        caught.map((item, index) => (
          <div class={`panel panel-${index}`}>
            <Code code={item.code} lang="ts" meta="twoslash" />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .caught {
    position: relative;
    display: grid;
    gap: 1rem 2rem;
    margin-top: 2rem;
  }
  @media (min-width: 56rem) {
    .caught {
      grid-template-columns: 15rem minmax(0, 1fr);
      align-items: start;
    }
  }
  .choice {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .list {
    display: grid;
    gap: 0.25rem;
  }
  label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 0.9rem;
    border-radius: 0.5rem;
    border-left: 3px solid transparent;
    color: var(--sl-color-gray-3);
    font-weight: 600;
    cursor: pointer;
    user-select: none;
  }
  label:hover {
    color: var(--sl-color-white);
  }
  .cross {
    color: var(--tetsu-red);
    font-size: 0.8rem;
  }
  .panels {
    display: grid;
    min-width: 0;
  }
  .panel {
    grid-area: 1 / 1;
    visibility: hidden;
    min-width: 0;
  }
  #caught-0:checked ~ .panels .panel-0,
  #caught-1:checked ~ .panels .panel-1,
  #caught-2:checked ~ .panels .panel-2 {
    visibility: visible;
  }
  #caught-0:checked ~ .list label[for="caught-0"],
  #caught-1:checked ~ .list label[for="caught-1"],
  #caught-2:checked ~ .list label[for="caught-2"] {
    background: var(--sl-color-gray-6);
    border-left-color: var(--tetsu-red);
    color: var(--sl-color-white);
  }
  #caught-0:focus-visible ~ .list label[for="caught-0"],
  #caught-1:focus-visible ~ .list label[for="caught-1"],
  #caught-2:focus-visible ~ .list label[for="caught-2"] {
    outline: 2px solid var(--sl-color-accent-high);
    outline-offset: 2px;
  }
</style>
